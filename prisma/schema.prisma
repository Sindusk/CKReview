generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum StaticMemberRole {
  OWNER
  MEMBER
}

model Static {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())

  /// app_user.id from the shared `users` database (see lib/usersDb.ts) — no
  /// FK, since that DB lives outside this datasource.
  createdByUserId Int

  members    StaticMember[]
  reviews    StaticReview[]
  identities StaticPlayerIdentity[]
  aliases    StaticPlayerAlias[]
  rules      StaticRule[]
  phases     StaticPhase[]
  excludedPlayers StaticExcludedPlayer[]
}

model StaticMember {
  id       Int              @id @default(autoincrement())
  staticId Int
  /// app_user.id from the shared `users` database — no FK, see Static.createdByUserId.
  userId   Int
  role     StaticMemberRole @default(MEMBER)
  addedAt  DateTime         @default(now())

  static Static @relation(fields: [staticId], references: [id], onDelete: Cascade)

  @@unique([staticId, userId])
  @@index([userId])
}

model StaticReview {
  id       Int    @id @default(autoincrement())
  staticId Int
  /// id of the file-backed review session in data/sessions/<id>.json (see
  /// lib/session-store.ts) — deliberately a plain string, not an FK; that
  /// store lives outside Postgres.
  sessionId String

  /// Denormalized from the session at add-time so listing a static's
  /// reviews never needs to touch the file store just to render a list.
  reportUrl String
  label     String?

  /// app_user.id from the shared `users` database — no FK, see Static.createdByUserId.
  addedByUserId Int
  addedAt       DateTime @default(now())

  /// When the underlying log was RECORDED — the WCL/FFLogs report's own
  /// `startTime`, captured at add/resync time from the client that has the
  /// report open. Distinct from addedAt (when someone attached the session
  /// to this static), which can be days later. Nullable: reviews added
  /// before this column existed have no value and render as "—" on the
  /// static dashboard until they're resynced.
  reportStartedAt DateTime?

  /// Shape version of the per-error/per-phase detail rows
  /// (StaticReviewPullError, StaticReviewPullPhase, the wipe cause) — null
  /// for sessions imported before detailed tracking, which keep only their
  /// count rows and stay out of the mechanic/phase views until resynced.
  /// See docs/static-player-analysis-plan.md.
  detailVersion Int?

  static Static @relation(fields: [staticId], references: [id], onDelete: Cascade)
  pulls  StaticReviewPull[]

  @@unique([staticId, sessionId])
  @@index([staticId])
}

/// One row per imported pull within a review — the per-pull data backing the
/// cross-pull error charts and notes. Populated at import time from the
/// session's Pull[] (see types/Pull.ts), not hand-entered.
model StaticReviewPull {
  id             Int    @id @default(autoincrement())
  staticReviewId Int
  /// Raw fight ID from the log source (Pull.fightId) — stable identity for
  /// this pull within the review, independent of display numbering.
  fightId        Int
  /// Sequential per-boss pull number (Pull.pullNumber), as shown in the UI
  /// ("#N") and used as the chart's x-axis.
  pullNumber     Int
  /// Boss/encounter name (Pull.name) — a review is expected to cover one
  /// encounter, but this is stored per-pull rather than assumed.
  bossName       String
  result         String // "Wipe" | "Kill" (Pull.result)
  /// "wow" | "ffxiv" (Pull.game) — determines which job-color/icon table a
  /// player's errors in this pull are read against.
  game           String
  startTime      Int
  endTime        Int
  /// Pull.fightDuration, ms — the pull's own length, used as the fallback
  /// "how long did this pull last" figure when raidErrorAtMs is null.
  durationMs     Int
  /// ms into the pull when the earliest Raid-severity error fired (see
  /// lib/report-data.ts's getPullRaidCutoff) — null if the pull has none.
  /// Shown as "wiped at" in the pull list; falls back to durationMs.
  raidErrorAtMs  Int?

  /// Freeform notes on what happened/went wrong during this pull. Nullable —
  /// most pulls won't have one unless someone writes it in during review.
  summary        String?

  /// Highest log phase id the pull reached (StaticReviewPullPhase.phase),
  /// derived from the phase transitions — not the log's own `lastPhase`,
  /// which is a stage ordinal (see lib/pull-phases.ts). Null without phase
  /// data or on sessions imported before detailed tracking.
  lastPhase      Int?

  /// What ended the pull (lib/static-review-data.ts computeWipeCause):
  /// "raidError" | "deathChain" | "called", or null for kills and wipes
  /// with no identifiable cause. The rule (raidError, or the Major error
  /// nearest a called wipe) or the killing ability (death chain, or the
  /// death nearest a called wipe) says which mechanic it was.
  endCauseKind     String?
  endCauseRuleId   Int?
  endCauseAbility  String?
  endCauseAtMs     Int?
  endCausePhase    Int?

  createdAt DateTime @default(now())

  review       StaticReview                 @relation(fields: [staticReviewId], references: [id], onDelete: Cascade)
  playerErrors StaticReviewPullPlayerError[]
  errors       StaticReviewPullError[]
  phases       StaticReviewPullPhase[]
  mechanics    StaticReviewPullMechanic[]
  endCauseRule StaticRule?                  @relation(fields: [endCauseRuleId], references: [id], onDelete: SetNull)

  @@unique([staticReviewId, fightId])
  @@index([staticReviewId])
}

/// One detection rule and error name as seen by a static (lookup for
/// StaticReviewPullError). `ruleKey` is "<ruleId>::<name>": generic rules
/// name each error after its ability, so the pair is what identifies it.
/// `name` keeps the snapshot readable after a rule is renamed or removed.
/// Mechanic key, label and phase hint come from lib/mechanics/rule-meta.ts
/// and are refreshed on every import, so relabeling a rule regroups old
/// sessions too.
model StaticRule {
  id            Int     @id @default(autoincrement())
  staticId      Int
  ruleKey       String
  name          String
  mechanicKey   String
  mechanicLabel String
  /// Log phase id the rule belongs to, used when a pull has no phase data.
  phaseHint     Int?

  static    Static                  @relation(fields: [staticId], references: [id], onDelete: Cascade)
  errors    StaticReviewPullError[]
  endCauses StaticReviewPull[]

  @@unique([staticId, ruleKey])
}

/// A phase's name for one boss in one static, from the report's phase
/// metadata (lib/pull-phases.ts) — so the UI can label phase ids without an
/// API call. Intermissions are phases of their own.
model StaticPhase {
  id             Int     @id @default(autoincrement())
  staticId       Int
  bossName       String
  phaseId        Int
  name           String
  isIntermission Boolean @default(false)

  static Static @relation(fields: [staticId], references: [id], onDelete: Cascade)

  @@unique([staticId, bossName, phaseId])
}

/// One detected error in a pull, every severity, including player-less Raid
/// errors and errors after the raid cutoff (flagged, not dropped — rankings
/// exclude them so they stay consistent with the count rows).
model StaticReviewPullError {
  id          Int     @id @default(autoincrement())
  pullId      Int
  /// Null for player-less errors and for names outside the pull's roster.
  identityId  Int?
  /// Raw log name in this pull (provenance), null for player-less errors.
  player      String?
  ruleRefId   Int
  severity    String  // "Major" | "Minor" | "Raid"
  timestampMs Int
  /// Log phase id at timestampMs, null without phase data.
  phase       Int?
  /// Which instance of the mechanic (e.g. spread #2); null until the boss
  /// module reports mechanic occurrences.
  occurrence  Int?
  /// After the pull's first Raid error (getPullRaidCutoff).
  afterCutoff Boolean @default(false)

  pull     StaticReviewPull      @relation(fields: [pullId], references: [id], onDelete: Cascade)
  identity StaticPlayerIdentity? @relation(fields: [identityId], references: [id], onDelete: SetNull)
  rule     StaticRule            @relation(fields: [ruleRefId], references: [id], onDelete: Cascade)

  @@index([pullId])
  @@index([identityId])
  @@index([ruleRefId])
}

/// One phase segment of a pull. Alternating encounters (Entombed Sentinels,
/// Sszorak) visit the same phase many times, so this is one row per visit;
/// "pulls that reached phase X" is a distinct count over pullId.
model StaticReviewPullPhase {
  id      Int @id @default(autoincrement())
  pullId  Int
  seq     Int
  phase   Int
  startMs Int
  endMs   Int

  pull StaticReviewPull @relation(fields: [pullId], references: [id], onDelete: Cascade)

  @@unique([pullId, seq])
}

/// One mechanic instance the pull reached, failed or not — the denominator
/// for "failed 4 of 9 times". Filled per boss module as they gain
/// occurrence output; mechanics without it fall back to phase exposure.
model StaticReviewPullMechanic {
  id          Int    @id @default(autoincrement())
  pullId      Int
  mechanicKey String
  occurrence  Int
  timestampMs Int
  phase       Int?

  pull StaticReviewPull @relation(fields: [pullId], references: [id], onDelete: Cascade)

  @@index([pullId])
}

/// Per-player error counts for one pull, computed at import time using the
/// same cutoff rule as the Report tab (lib/report-data.ts's
/// getPullCriticalEvents): only Major errors up to the earliest Raid-severity
/// error (auto-detected or a manual Call Wipe) count. Major/Minor are kept
/// separate so future charts can filter or weight by severity rather than
/// only ever showing a combined total.
model StaticReviewPullPlayerError {
  id     Int    @id @default(autoincrement())
  pullId Int
  /// Raw player name as it appeared in THIS pull's log — kept verbatim
  /// (never edited) for provenance even after `identity` resolves it to a
  /// merged canonical player (see StaticPlayerIdentity's header comment for
  /// why raw log names alone aren't a stable join key across reports).
  player String

  /// This player's class/spec/role in THIS pull, snapshotted from
  /// Pull.players (not derived from the error rows, so it's populated even
  /// for players who racked up zero errors here) — a player can change job
  /// between reports, or in principle mid-report, so this is captured per
  /// pull rather than assumed constant for the whole static.
  className String?
  specId    Int?
  role      String?

  majorCount Int @default(0)
  minorCount Int @default(0)

  pull     StaticReviewPull      @relation(fields: [pullId], references: [id], onDelete: Cascade)
  /// Resolved canonical player across name changes (see
  /// StaticPlayerIdentity) — nullable only because rows written before this
  /// column existed have none; every row from here on gets one.
  identityId Int?
  identity   StaticPlayerIdentity? @relation(fields: [identityId], references: [id], onDelete: SetNull)

  @@unique([pullId, player])
  @@index([pullId])
  @@index([identityId])
}

/// A canonical player identity within one static, so error counts/charts
/// still group correctly when someone's log name changes across reports
/// (observed 2026-07-31: "Salty Dango" -> "Kup'o Noodles" across sessions of
/// the same static). Auto-created the first time a never-before-seen name
/// is imported (1 identity = 1 alias = that name); merged manually
/// afterward via POST /api/statics/[staticId]/players/merge once a
/// reviewer recognizes two names as the same person. `name` is the
/// canonical display name shown in the chart/legend — defaults to
/// whichever name was first seen, editable afterward.
model StaticPlayerIdentity {
  id        Int      @id @default(autoincrement())
  staticId  Int
  name      String
  createdAt DateTime @default(now())

  static  Static                       @relation(fields: [staticId], references: [id], onDelete: Cascade)
  aliases StaticPlayerAlias[]
  errors  StaticReviewPullPlayerError[]
  detailErrors StaticReviewPullError[]

  @@index([staticId])
}

/// One raw log name that has resolved to a given identity. A fresh name
/// starts as its own identity with exactly one alias (itself); merging two
/// identities moves the loser's aliases here onto the winner.
model StaticPlayerAlias {
  id         Int    @id @default(autoincrement())
  staticId   Int
  identityId Int
  name       String

  identity StaticPlayerIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  static   Static               @relation(fields: [staticId], references: [id], onDelete: Cascade)

  @@unique([staticId, name])
  @@index([identityId])
}

/// A log name deleted from one session of a static (Players panel ->
/// Delete), so a resync of that session keeps dropping every pull the name
/// appears in instead of re-adding them. Keyed by sessionId rather than
/// StaticReview, because a review left with no pulls is deleted outright
/// and re-adding the session must still honor it. Scoped to the sessions
/// the name was in when deleted: new sessions import it normally.
model StaticExcludedPlayer {
  id        Int      @id @default(autoincrement())
  staticId  Int
  sessionId String
  name      String
  createdAt DateTime @default(now())

  static Static @relation(fields: [staticId], references: [id], onDelete: Cascade)

  @@unique([staticId, sessionId, name])
}
