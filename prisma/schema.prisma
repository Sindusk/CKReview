generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum StaticMemberRole {
  OWNER
  MEMBER
}

model Static {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())

  /// app_user.id from the shared `users` database (see lib/usersDb.ts) — no
  /// FK, since that DB lives outside this datasource.
  createdByUserId Int

  members    StaticMember[]
  reviews    StaticReview[]
  identities StaticPlayerIdentity[]
  aliases    StaticPlayerAlias[]
}

model StaticMember {
  id       Int              @id @default(autoincrement())
  staticId Int
  /// app_user.id from the shared `users` database — no FK, see Static.createdByUserId.
  userId   Int
  role     StaticMemberRole @default(MEMBER)
  addedAt  DateTime         @default(now())

  static Static @relation(fields: [staticId], references: [id], onDelete: Cascade)

  @@unique([staticId, userId])
  @@index([userId])
}

model StaticReview {
  id       Int    @id @default(autoincrement())
  staticId Int
  /// id of the file-backed review session in data/sessions/<id>.json (see
  /// lib/session-store.ts) — deliberately a plain string, not an FK; that
  /// store lives outside Postgres.
  sessionId String

  /// Denormalized from the session at add-time so listing a static's
  /// reviews never needs to touch the file store just to render a list.
  reportUrl String
  label     String?

  /// app_user.id from the shared `users` database — no FK, see Static.createdByUserId.
  addedByUserId Int
  addedAt       DateTime @default(now())

  static Static @relation(fields: [staticId], references: [id], onDelete: Cascade)
  pulls  StaticReviewPull[]

  @@unique([staticId, sessionId])
  @@index([staticId])
}

/// One row per imported pull within a review — the per-pull data backing the
/// cross-pull error charts and notes. Populated at import time from the
/// session's Pull[] (see types/Pull.ts), not hand-entered.
model StaticReviewPull {
  id             Int    @id @default(autoincrement())
  staticReviewId Int
  /// Raw fight ID from the log source (Pull.fightId) — stable identity for
  /// this pull within the review, independent of display numbering.
  fightId        Int
  /// Sequential per-boss pull number (Pull.pullNumber), as shown in the UI
  /// ("#N") and used as the chart's x-axis.
  pullNumber     Int
  /// Boss/encounter name (Pull.name) — a review is expected to cover one
  /// encounter, but this is stored per-pull rather than assumed.
  bossName       String
  result         String // "Wipe" | "Kill" (Pull.result)
  /// "wow" | "ffxiv" (Pull.game) — determines which job-color/icon table a
  /// player's errors in this pull are read against.
  game           String
  startTime      Int
  endTime        Int
  /// Pull.fightDuration, ms — the pull's own length, used as the fallback
  /// "how long did this pull last" figure when raidErrorAtMs is null.
  durationMs     Int
  /// ms into the pull when the earliest Raid-severity error fired (see
  /// lib/report-data.ts's getPullRaidCutoff) — null if the pull has none.
  /// Shown as "wiped at" in the pull list; falls back to durationMs.
  raidErrorAtMs  Int?

  /// Freeform notes on what happened/went wrong during this pull. Nullable —
  /// most pulls won't have one unless someone writes it in during review.
  summary        String?

  createdAt DateTime @default(now())

  review       StaticReview                 @relation(fields: [staticReviewId], references: [id], onDelete: Cascade)
  playerErrors StaticReviewPullPlayerError[]

  @@unique([staticReviewId, fightId])
  @@index([staticReviewId])
}

/// Per-player error counts for one pull, computed at import time using the
/// same cutoff rule as the Report tab (lib/report-data.ts's
/// getPullCriticalEvents): only Major errors up to the earliest Raid-severity
/// error (auto-detected or a manual Call Wipe) count. Major/Minor are kept
/// separate so future charts can filter or weight by severity rather than
/// only ever showing a combined total.
model StaticReviewPullPlayerError {
  id     Int    @id @default(autoincrement())
  pullId Int
  /// Raw player name as it appeared in THIS pull's log — kept verbatim
  /// (never edited) for provenance even after `identity` resolves it to a
  /// merged canonical player (see StaticPlayerIdentity's header comment for
  /// why raw log names alone aren't a stable join key across reports).
  player String

  /// This player's class/spec/role in THIS pull, snapshotted from
  /// Pull.players (not derived from the error rows, so it's populated even
  /// for players who racked up zero errors here) — a player can change job
  /// between reports, or in principle mid-report, so this is captured per
  /// pull rather than assumed constant for the whole static.
  className String?
  specId    Int?
  role      String?

  majorCount Int @default(0)
  minorCount Int @default(0)

  pull     StaticReviewPull      @relation(fields: [pullId], references: [id], onDelete: Cascade)
  /// Resolved canonical player across name changes (see
  /// StaticPlayerIdentity) — nullable only because rows written before this
  /// column existed have none; every row from here on gets one.
  identityId Int?
  identity   StaticPlayerIdentity? @relation(fields: [identityId], references: [id], onDelete: SetNull)

  @@unique([pullId, player])
  @@index([pullId])
  @@index([identityId])
}

/// A canonical player identity within one static, so error counts/charts
/// still group correctly when someone's log name changes across reports
/// (observed 2026-07-31: "Salty Dango" -> "Kup'o Noodles" across sessions of
/// the same static). Auto-created the first time a never-before-seen name
/// is imported (1 identity = 1 alias = that name); merged manually
/// afterward via POST /api/statics/[staticId]/players/merge once a
/// reviewer recognizes two names as the same person. `name` is the
/// canonical display name shown in the chart/legend — defaults to
/// whichever name was first seen, editable afterward.
model StaticPlayerIdentity {
  id        Int      @id @default(autoincrement())
  staticId  Int
  name      String
  createdAt DateTime @default(now())

  static  Static                       @relation(fields: [staticId], references: [id], onDelete: Cascade)
  aliases StaticPlayerAlias[]
  errors  StaticReviewPullPlayerError[]

  @@index([staticId])
}

/// One raw log name that has resolved to a given identity. A fresh name
/// starts as its own identity with exactly one alias (itself); merging two
/// identities moves the loser's aliases here onto the winner.
model StaticPlayerAlias {
  id         Int    @id @default(autoincrement())
  staticId   Int
  identityId Int
  name       String

  identity StaticPlayerIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  static   Static               @relation(fields: [staticId], references: [id], onDelete: Cascade)

  @@unique([staticId, name])
  @@index([identityId])
}
