# This app's own database (Static / StaticMember / StaticReview).
DATABASE_URL="postgresql://user:password@localhost:5432/ckreview"

# Shared consistencykings.com users database — same value as Stonks' .env,
# so a login on either app works on both.
USERS_DATABASE_URL="postgresql://user:password@localhost:5432/users"

# Parent domain the session cookie is scoped to in production, e.g.
# ".consistencykings.com". Leave unset locally for a host-only cookie.
COOKIE_DOMAIN=
